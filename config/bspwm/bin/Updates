#!/bin/sh
# =============================================================
# Author: gh0stzk (adapted for Kali Linux)
# Repo:   https://github.com/gh0stzk/dotfiles
# Date:   06.04.2025 09:41:28
#
# KaliUpdates - Script to check for new updates in Kali/Debian
#               and sync updates module in polybar/Eww.
# Features:
#   ✔ Shows the number of updates available in polybar/eww
#   ✔ Used in a systemd timer to update the polybar-module/eww-poll.
#
# Dependencies:
#   → apt, polybar
#
# Copyright (C) 2021-2025 gh0stzk <z0mbi3.zk@protonmail.com>
# Licensed under GPL-3.0 license
# =============================================================

UPDATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/Updates.txt"

# Main verification function
check_updates() {
    # Get updates from apt
    updates=0
    update_list=""

    # Update package index silently
    sudo apt-get update >/dev/null 2>&1

    # Get list of upgradable packages
    if update_list=$(apt list --upgradable 2>/dev/null | grep -v "Listing..."); then
        updates=$(echo "$update_list" | grep -c "upgradable" 2>/dev/null || echo "0")
    fi

    # Write total to file
    echo "$updates" > "$UPDATE_FILE"

    # Sends the signal to polybar-module/eww-poll to update the data.
    if pgrep -x polybar >/dev/null; then
        polybar-msg action updates hook 0 >/dev/null 2>&1
    else
        read -r current_rice < "$HOME"/.config/bspwm/.rice
        eww -c "$HOME/.config/bspwm/rices/${current_rice}/bar" poll UPDATES 2>/dev/null
    fi
}

list_updates() {
    check_updates
    if [ "$updates" -gt 0 ]; then
        printf "\033[1m\033[33mThere are %s updates available:\033[0m\n" "$updates"

        if [ -n "$update_list" ]; then
            printf "\n\033[1m\033[34mAvailable updates:\033[0m\n"
            printf "%s\n" "$update_list" | sed 's/upgradable/\x1b[32;1mupgradable\x1b[0m/g'
        fi
    else
        printf "\033[1m\033[32m¡Your system is already updated!\033[0m\n"
    fi
    exit 0
}

# Execute it accordingly
case "$1" in
    --sync-polybar)
        check_updates ;;
    --print-updates)
        list_updates ;;
    *)
        echo "$(basename "$0") [OPTIONS]"
        echo "  --sync-polybar      Sync data & polybar module"
        echo "  --print-updates     Sync data, polybar module & print available apps to update"
        exit 1
    ;;
esac
